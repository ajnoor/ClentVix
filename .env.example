# --- Database (Neon) -------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Google sign-in (Auth.js) ----------------------------------------------
AUTH_SECRET=            # generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_GOOGLE_ID=         # Google Cloud OAuth client ID
AUTH_GOOGLE_SECRET=     # Google Cloud OAuth client secret
# AUTH_URL=http://localhost:3000   # only needed outside Vercel / behind custom proxies
# AUTH_TRUST_HOST=true             # set on non-Vercel hosts behind a proxy

# --- Discovery provider: Google Places API (New) ---------------------------
GOOGLE_PLACES_API_KEY=

# --- Gemini (server-side only; never prefix with NEXT_PUBLIC_) -------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- Optional abuse / cost controls ----------------------------------------
# ALLOWED_EMAILS=you@example.com,teammate@example.com   # if set, only these Google accounts may sign in
# DISCOVERY_DAILY_LIMIT=20                               # discoveries per user per rolling 24h
